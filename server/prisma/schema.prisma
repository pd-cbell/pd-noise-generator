// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  googleId      String    @unique
  name          String?
  avatarUrl     String?
  pdRegion      String?   @default("US")
  role          Role      @default(EDITOR) // New: User role for RBAC

  // Encrypted Credentials
  encryptedPagerDutyApiToken String?
  encryptedGlobalRoutingKey  String?
  encryptedFromEmail         String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profiles      Profile[]
  goldenDemos   GoldenDemo[] // Inverse relation for GoldenDemo
}

model Profile {
  id          String   @id @default(uuid())
  name        String
  description String?
  settings    Json // Stores the configuration object
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id])
}

// v2.0 Taxonomy Models

model Domain {
  id        String   @id @default(uuid())
  name      String   @unique
  teams     Team[]
  createdAt DateTime @default(now())
}

model Team {
  id        String    @id @default(uuid())
  name      String
  persona   String? // ChatOps tone/persona: e.g., "Anxious", "Professional", "Casual", "Sarcastic"
  domainId  String
  domain    Domain    @relation(fields: [domainId], references: [id])
  services  Service[]
  createdAt DateTime  @default(now())
}

model Service {
  id                   String            @id @default(uuid())
  name                 String
  integrationKey       String? // PagerDuty Integration Key
  changeIntegrationKey String? // New: Specific key for Change Events
  type                 String            @default("technical") // "technical" or "business"
  teamId               String
  team                 Team              @relation(fields: [teamId], references: [id])
  templates            PayloadTemplate[]
  createdAt            DateTime          @default(now())
}

model PayloadTemplate {
  id                   String   @id @default(uuid())
  name                 String
  description          String?
  template             String // The JSON string containing {{faker...}} tokens
  slackMessageTemplate String? // ChatOps message template
  isDraft              Boolean  @default(true)
  serviceId            String
  service              Service  @relation(fields: [serviceId], references: [id])
  createdAt            DateTime @default(now())
}

model GoldenDemo {
  id              String    @id @default(uuid())
  name            String
  vertical        String
  maturityLevel   String
  narrative       String
  configJson      Json      // Stores the full simulation configuration, including beats
  personaNotes    String?
  createdByUserId String
  user            User      @relation(fields: [createdByUserId], references: [id])
  sessions        Session[] // Inverse relation for Session
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([name, createdByUserId]) // Ensure unique name per user
}

model Session {
  id                  String     @id @default(uuid())
  goldenDemoId        String
  goldenDemo          GoldenDemo @relation(fields: [goldenDemoId], references: [id], onDelete: Cascade)
  name                String?    // e.g., "Demo for Acme Corp"
  startedAt           DateTime   @default(now())
  endedAt             DateTime?
  metricsSnapshotJson Json?      // Stores MTTA, MTTR, Incident Counts at session end
  notes               String?    // User notes for this specific run
  createdByUserId     String?    // Optional: link to User who ran it
  
  @@index([goldenDemoId])
}

model MappingProfile {
  id                       String            @id @default(cuid())
  name                     String
  description              String?
  globalIncidentRoutingKey String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  serviceMappings          ServiceMapping[]
}

model ServiceMapping {
  id                        String          @id @default(cuid())
  mappingProfileId          String
  logicalServiceName        String
  incidentServiceId         String?
  incidentServiceName       String?
  incidentRoutingKeyOverride String?
  changeRoutingKeyOverride  String?
  changeServiceId           String?
  changeServiceName         String?
  useIncidentForChange      Boolean         @default(true)
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  mappingProfile            MappingProfile  @relation(fields: [mappingProfileId], references: [id], onDelete: Cascade)
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}
