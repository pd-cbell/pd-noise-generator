// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  googleId      String    @unique
  name          String?
  avatarUrl     String?
  
  // Encrypted Credentials
  encryptedPagerDutyApiToken String?
  encryptedGlobalRoutingKey  String?
  encryptedFromEmail         String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profiles      Profile[]
  campaigns     Campaign[]
}

model Profile {
  id          String   @id @default(uuid())
  name        String
  description String?
  settings    Json     // Stores the configuration object
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  description String?
  source      String?        // Optional: to track origin (e.g., filename)
  integrationKey String?     // Campaign-level Incident Routing Key
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  items       CampaignItem[]
  
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
}

model CampaignItem {
  id              String   @id @default(cuid())
  campaignId      String
  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  order           Int      // To maintain execution sequence
  
  stepName        String?  // New: Optional name for the step
  payload         Json     // Raw event payload
  eventAction     String   @default("trigger")
  eventType       String   @default("alert") // "alert" or "change"
  dedupKey        String?
  integrationKey  String?  // New: Optional override for change events
  
  delaySeconds    Int      @default(0)
  repeatCount     Int      @default(1) // Renamed from 'times' for clarity
  intervalSeconds Int      @default(0)
}

// v2.0 Taxonomy Models

model Domain {
  id        String   @id @default(uuid())
  name      String   @unique
  teams     Team[]
  createdAt DateTime @default(now())
}

model Team {
  id        String    @id @default(uuid())
  name      String
  persona   String?   // e.g., "Stressed, technical, uses emojis"
  domainId  String
  domain    Domain    @relation(fields: [domainId], references: [id])
  services  Service[]
  createdAt DateTime  @default(now())
}

model Service {
  id                   String            @id @default(uuid())
  name                 String
  integrationKey       String?           // PagerDuty Integration Key
  changeIntegrationKey String?           // New: Specific key for Change Events
  type                 String            @default("technical") // "technical" or "business"
  teamId               String
  team                 Team              @relation(fields: [teamId], references: [id])
  templates            PayloadTemplate[]
  createdAt            DateTime          @default(now())
}

model PayloadTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  template    String   // The JSON string containing {{faker...}} tokens
  slackMessageTemplate String? // ChatOps message template
  isDraft     Boolean  @default(true)
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id])
  createdAt   DateTime @default(now())
}