# Server environment variables for PagerDuty Incident Noise Simulator
# Copy to server/.env and fill in required values.

# Core server
PORT=3001
CLIENT_URL=http://localhost:5173
PD_API_BASE=https://api.pagerduty.com

# Persistence
# DATABASE_URL is required for Prisma/Postgres. Use docker-compose default or RDS URL.
# Example (Docker compose): postgresql://pdns:pdnspassword@localhost:5432/pdns_db
# Example (RDS): postgresql://USER:PASSWORD@host:5432/pdns_db
DATABASE_URL=

# Auth & security
# JWT_SECRET is required in production; a dev fallback is only used when NODE_ENV !== production.
JWT_SECRET=
# 32-char key for encrypting stored PagerDuty tokens/keys.
ENCRYPTION_KEY=

# PagerDuty credentials
# REST API token used by the backend simulation engine for incident lifecycle.
PD_REST_API_TOKEN=
# From address required by PagerDuty REST API (should match token owner domain).
PD_FROM_EMAIL=
# Events API routing key for default alert generation (can be overridden per-service).
PD_EVENTS_ROUTING_KEY=
# Optional change events routing key if you want a global default.
PD_CHANGE_EVENTS_ROUTING_KEY=

# OAuth / Identity
GOOGLE_CLIENT_ID=

# AI Providers (optional but recommended)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Integrations
# Optional Slack webhook for Director/Agent chatter.
SLACK_WEBHOOK_URL=

# Runtime
NODE_ENV=development
