# Client environment variables for PagerDuty Incident Noise Simulator (Vite)
# Copy to client/.env and fill in required values.

# URL of the backend API/socket server (include protocol). Defaults to local dev.
VITE_API_URL=http://localhost:3001

# Google OAuth client ID for browser sign-in.
VITE_GOOGLE_CLIENT_ID=

# Optional override for webhook URLs shown in Golden Demo detail.
# Defaults to window.location.origin when unset.
VITE_WEBHOOK_BASE_URL=
